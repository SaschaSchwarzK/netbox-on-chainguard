ALLOWED_HOSTS=*
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=<db-password>
REDIS_HOST=redis
REDIS_PASSWORD=<redis-password>
SECRET_KEY=<secret-key-min-50-chars>
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=<superuser-password>
SKIP_SUPERUSER=false
MAX_DB_WAIT_TIME=60
